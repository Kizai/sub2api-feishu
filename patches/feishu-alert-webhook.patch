+// maybeSendAlertFeishu 定制功能：把告警事件推送到飞书群机器人（不依赖邮件配置）
+func (s *OpsAlertEvaluatorService) maybeSendAlertFeishu(ctx context.Context, runtimeCfg *OpsAlertRuntimeSettings, rule *OpsAlertRule, event *OpsAlertEvent, status string, resolvedAt *time.Time) bool {
+	if s == nil || s.opsService == nil || event == nil || rule == nil {
+		return false
+	}
+
+	feishuCfg, err := s.opsService.GetEmailNotificationConfig(ctx)
+	if err != nil || feishuCfg == nil || !feishuCfg.Feishu.Enabled {
+		return false
+	}
+	webhookURL := strings.TrimSpace(feishuCfg.Feishu.WebhookURL)
+	if webhookURL == "" || !strings.HasPrefix(webhookURL, "https://") {
+		return false
+	}
+	if !shouldSendOpsAlertEmailByMinSeverity(strings.TrimSpace(feishuCfg.Feishu.MinSeverity), strings.TrimSpace(rule.Severity)) {
+		return false
+	}
+	if runtimeCfg != nil && runtimeCfg.Silencing.Enabled {
+		if isOpsAlertSilenced(time.Now().UTC(), rule, event, runtimeCfg.Silencing) {
+			return false
+		}
+	}
+
+	text := buildOpsAlertFeishuText(rule, event, status, resolvedAt)
+	return s.sendFeishuText(webhookURL, text)
+}
+
+func buildOpsAlertFeishuText(rule *OpsAlertRule, event *OpsAlertEvent, status string, resolvedAt *time.Time) string {
+	severity := strings.TrimSpace(rule.Severity)
+	name := strings.TrimSpace(rule.Name)
+	desc := strings.TrimSpace(event.Description)
+	tz := time.FixedZone("CST", 8*3600)
+	if status == OpsAlertStatusResolved {
+		at := "-"
+		if resolvedAt != nil {
+			at = resolvedAt.In(tz).Format("2006-01-02 15:04:05")
+		}
+		return fmt.Sprintf("✅ [Sub2API 告警恢复]\n规则: %s\n级别: %s\n描述: %s\n恢复时间: %s", name, severity, desc, at)
+	}
+	firedAt := event.FiredAt.In(tz).Format("2006-01-02 15:04:05")
+	icon := "🚨"
+	if severity == "P1" {
+		icon = "⚠️"
+	}
+	return fmt.Sprintf("%s [Sub2API 告警]\n规则: %s\n级别: %s\n描述: %s\n触发时间: %s", icon, name, severity, desc, firedAt)
+}
+
+// sendFeishuText 发送飞书 text 消息，失败仅记录日志（best-effort）
+func (s *OpsAlertEvaluatorService) sendFeishuText(webhookURL, text string) bool {
+	if s == nil || text == "" {
+		return false
+	}
+	// 简单节流：两次推送至少间隔 1 秒，避免规则同时触发时打爆机器人
+	s.feishuMu.Lock()
+	if wait := time.Second - time.Since(s.feishuAt); wait > 0 {
+		time.Sleep(wait)
+	}
+	s.feishuAt = time.Now()
+	s.feishuMu.Unlock()
+
+	if s.feishuClient == nil {
+		s.feishuClient = &http.Client{Timeout: 8 * time.Second}
+	}
+	payload, err := json.Marshal(map[string]any{
+		"msg_type": "text",
+		"content":  map[string]string{"text": text},
+	})
+	if err != nil {
+		return false
+	}
+	resp, err := s.feishuClient.Post(webhookURL, "application/json", bytes.NewReader(payload))
+	if err != nil {
+		logger.LegacyPrintf("service.ops_alert_evaluator", "[OpsAlertEvaluator] feishu push failed: %v", err)
+		return false
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 512))
+	if resp.StatusCode != http.StatusOK {
+		logger.LegacyPrintf("service.ops_alert_evaluator", "[OpsAlertEvaluator] feishu push http %d: %s", resp.StatusCode, string(body))
+		return false
+	}
+	var fr struct {
+		Code int    `json:"code"`
+		Msg  string `json:"msg"`
+	}
+	if json.Unmarshal(body, &fr) == nil && fr.Code != 0 {
+		logger.LegacyPrintf("service.ops_alert_evaluator", "[OpsAlertEvaluator] feishu push rejected: code=%d msg=%s", fr.Code, fr.Msg)
+		return false
+	}
+	return true
+}
